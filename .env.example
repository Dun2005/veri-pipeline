# Environment variables for verification pipeline
# Copy this file to .env and fill in your keys

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Critic / Judge Model:
# Gemini: "gemini-3.8-flash" (Recommended), "gemini-3.1-pro-preview", "gemini-flash-latest"
# OpenAI: "gpt-4o", "o3-mini", "gpt-4o-mini"
JUDGE_MODEL=gemini-3.8-flash

# Actor / Generator Model:
# Gemini: "gemini-3.5-flash-lite", "gemini-3.8-flash"
# OpenAI: "gpt-4o-mini", "gpt-4o"
GENERATOR_MODEL=gemini-3.5-flash-lite
